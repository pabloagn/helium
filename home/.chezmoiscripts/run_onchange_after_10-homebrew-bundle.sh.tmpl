{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

# Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}

if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew must be installed before applying Helium." >&2
    exit 1
fi

# SketchyBar, JankyBorders (the `borders` formula) and AutoRaise ship in
# third-party taps. Homebrew 6 refuses to load a formula from an untrusted tap
# until it is trusted (casks, such as orca, are trusted separately in
# trust.json). Trust each single formula rather than the whole tap, and only
# when it is not already trusted, so the step stays idempotent under `set -eu`.
trusted=$(brew trust --json v1)
for formula in felixkratz/formulae/sketchybar felixkratz/formulae/borders dimentium/autoraise/autoraise; do
    if ! printf '%s' "$trusted" | grep -q "$formula"; then
        brew trust --formula "$formula"
    fi
done

brew bundle --global
{{- end }}
