{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

# Native menu bar visibility. Paired with the SketchyBar master switch in
# run_onchange_after_15-sketchybar: when SketchyBar is enabled the native bar
# auto-hides, and when SketchyBar is parked (current state, 2026-08-21) the
# native bar is visible. Flip both together.
#
# The osascript path applies the change live, without a logout: System Events
# exposes the same "Automatically hide and show the menu bar" preference the
# System Settings toggle writes. The defaults fallback covers a machine where
# Automation permission is not granted yet; it needs a logout to take effect.
if ! osascript -e 'tell application "System Events" to set autohide menu bar of dock preferences to false' >/dev/null 2>&1; then
    defaults write NSGlobalDomain _HIHideMenuBar -bool false
    echo "Automation permission missing; wrote the default instead. Log out and log in to apply." >&2
fi

echo "Native menu bar restored (always visible)."
{{- end }}
