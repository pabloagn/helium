{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

# OmniWM owns pointer focus. AutoRaise is retained only for AeroSpace rollback.
# config hash: {{ include "dot_config/AutoRaise/config" | sha256sum }}

if ! command -v AutoRaise >/dev/null 2>&1; then
    echo "AutoRaise is not installed; skipping restart." >&2
    exit 0
fi

if brew services info autoraise --json | jq -e '.[0].running' >/dev/null; then
    brew services stop autoraise
fi
{{- end }}
