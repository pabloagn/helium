{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

# OmniWM owns the focus border. Keep the AeroSpace-era configuration for
# rollback, but never run two border renderers on the same windows.

if ! command -v borders >/dev/null 2>&1; then
    exit 0
fi

if brew services info borders --json | jq -e '.[0].running' >/dev/null; then
    brew services stop borders
fi
{{- end }}
