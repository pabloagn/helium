# Configuration management
brew "chezmoi"
brew "just"

# Shells
brew "fish"
brew "nushell"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Prompt and terminal sessions
brew "starship"
# gdate for the starship command-timer hooks (fish functions/__starship_*.fish
# and the zsh block in ~/.zshrc). macOS date has no millisecond precision.
brew "coreutils"
brew "zellij"

# Git
brew "git"
brew "gh"
brew "git-delta"
brew "gitui"
brew "lazygit"
brew "commitizen"
# Syntax-aware diffs. Understands structure rather than lines, which makes
# reviewing generated or refactored code far less noisy than a textual diff.
brew "difftastic"
# Jujutsu: Git-compatible VCS with first-class stacked changes, and the VCS
# GitHub's stacked-PR preview explicitly supports. Colocates with an existing
# Git repo, so adopting it is reversible.
brew "jj"

# Code quality gates. Hooks guard the front door, CI watches the perimeter --
# with agents writing at speed, the front door is what catches things early.
brew "lefthook"   # one binary, one config, every git hook
brew "gitleaks"   # secret scanning; replaces the hand-rolled rg check in justfile
brew "semgrep"    # semantic static analysis
brew "act"        # run GitHub Actions locally instead of push-wait-fail

# Shell history and navigation
brew "atuin"
brew "direnv"
brew "zoxide"
brew "fzf"

# Files and viewing
brew "bat"
brew "eza"
brew "fd"
brew "yazi"
brew "glow"

# Yazi previewers and plugin dependencies. Yazi degrades quietly when these are
# absent: the preview pane simply falls back to plain file(1) output.
brew "ffmpeg"      # video thumbnails
brew "sevenzip"    # archive listing
brew "poppler"     # PDF previews
brew "imagemagick" # SVG, HEIC, AVIF, JXL previews
brew "resvg"       # faster SVG rendering
brew "duckdb"      # CSV, TSV, Parquet and database previews
brew "mediainfo"   # media metadata
brew "ouch"        # archive preview and extraction

# Search and text processing
brew "ripgrep"
brew "ripgrep-all"
brew "sd"
brew "jq"
brew "yq"
brew "miller"

# Monitoring and storage
brew "btop"
brew "bottom"
brew "duf"
brew "dust"

# Network utilities
brew "wget"
brew "xh"

# General utilities
brew "tree"

# Editors
brew "neovim"
brew "helix"
# tree-sitter CLI lets nvim-treesitter build grammars that ship as grammar.js
# rather than checked-in C (latex is one). This is tree-sitter-cli, not
# tree-sitter: the latter is the library and ships no binary. node is needed
# only for that generation step, never at runtime.
brew "tree-sitter-cli"
brew "node"

# Language servers. On Rhodium, Nix provides every server the Neovim config
# enables; here brew provides the base set. Servers missing from this machine
# are skipped by the executable guard in nvim/lua/pcfg/nvim-lspconfig.lua, so
# they never warn. nil and nixd (Nix LSPs) have no brew formula and need Nix
# itself, so Nix files have no LSP on this machine.
brew "lua-language-server"            # Lua
brew "pyright"                        # Python (ruff below covers lint/format)
brew "rust-analyzer"                  # Rust
brew "gopls"                          # Go
brew "metals"                         # Scala
brew "bash-language-server"           # Bash
brew "shellcheck"                     # bash-language-server runs it for diagnostics
brew "fish-lsp"                       # Fish
brew "marksman"                       # Markdown
brew "taplo"                          # TOML
brew "yaml-language-server"           # YAML
brew "vscode-langservers-extracted"   # JSON, HTML, CSS, ESLint
brew "texlab"                         # LaTeX
brew "tinymist"                       # Typst
brew "just-lsp"                       # just recipes

# Python. The 2026 toolchain converged on uv + Ruff + a Rust type checker.
brew "uv"
brew "ruff"
# Pyrefly reached stable 1.0 in May 2026 and is dramatically faster than mypy
# (seconds rather than minutes on large trees) at a fraction of the memory.
# Astral's `ty` is the likely long-term successor but is still alpha, so it is
# deliberately not pinned here yet.
brew "pyrefly"

# Qalculate!: scientific calculator with a symbolic solver, unit and currency
# conversion, and plotting. A formula rather than a cask because upstream ships
# no macOS binary, so Homebrew compiles the Qt front end itself and leaves
# `qalculate-qt.app` inside the Cellar. `run_after_40-qalculate-app.sh.tmpl`
# copies that bundle into /Applications, which is what makes it reachable from
# Raycast. The formula also pulls in libqalculate, whose `qalc` command is the
# same engine on the terminal.
brew "qalculate-qt"

# Existing Homebrew-managed applications
cask "codex"
cask "claude-code"
# Conductor: runs Claude Code sessions in parallel, each in its own git
# worktree, with a diff-first review UI. Works alongside VS Code rather than
# replacing it.
cask "conductor"
# Fantastical: each Google account is added inside the app and authenticated
# against the Google Calendar API directly, so it never routes through macOS
# Internet Accounts. That is the point -- Calendar.app reaches Google over
# CalDAV, which drops whenever the OAuth refresh token expires. Calendar Sets
# group the AtmosphericAI and personal accounts the way the Firefox profiles do.
cask "fantastical"
# Amie: also native, keyboard-driven throughout. Installed alongside Fantastical
# to trial both; drop the loser. Note Amie syncs through its own backend rather
# than authenticating locally, which is worth checking before a work Workspace
# account goes in it.
cask "amie"
# PDF Expert: full PDF reader and editor. Handles large and complex files that
# Preview struggles with, plus text editing, form filling and annotation.
cask "pdf-expert"
# Neovide: native GUI front end for Neovim, driven by the same config as the
# terminal one. Adds smooth scrolling, animated window transitions, font
# ligatures and the animated cursor trail (its "cursor particles" setting).
# Named neovide-app, not neovide: homebrew-cask renamed it, and the old name is
# a stub that emits a rename warning on every `brew bundle`.
cask "neovide-app"
# Craft: native document editor. Official homebrew-cask formula, and the app
# self-updates, so `brew upgrade` is a no-op unless called with --greedy.
cask "craft"

# Consumer applications: VPN, media, and messaging.
cask "protonvpn"
cask "vlc"
cask "discord"
cask "telegram"
cask "signal"
cask "brave-browser"

# Terminal emulators. All four are official homebrew-cask entries.
# Ghostty is the incumbent: ~/.config/ghostty in this repo configures it, so
# without this line a fresh machine gets the config and no app.
cask "ghostty"
# The three below are installed alongside it for comparison.
# kitty: GPU-drawn, configured by a plain text file, no tabs-in-window chrome.
cask "kitty"
# Tabby: Electron, and the only one of the three with a built-in SSH and serial
# client, so it is the one to keep if a serial console is ever needed.
cask "tabby"
# Wave: Electron. Puts file previews, graphs and AI blocks inside the terminal
# grid itself rather than in a side pane. Self-updates, so `brew upgrade` is a
# no-op for it unless called with --greedy.
cask "wave"

# Proton Mail: the desktop client, which wraps the same web app the
# `proton-mail` Raycast script opens in the Personal Firefox profile. It brings
# offline access and native notifications. Self-updates, so `brew upgrade` is a
# no-op for it unless called with --greedy.
cask "proton-mail"

# Third-party tap, reviewed per the policy in README.md. Orca is an Agent
# Development Environment: it runs Claude Code, Codex and 30+ other CLI agents
# side by side, each in its own git worktree, and drives them with your existing
# subscriptions rather than proxying through a vendor. MIT licensed.
#
# Tap review: Casks/orca.rb in stablyai/homebrew-orca downloads the .dmg from
# github.com/stablyai/orca/releases with a matching `verified:` owner, pins a
# per-architecture sha256, declares no install scripts, and sets auto_updates
# because the app self-updates via electron-updater. `brew upgrade` is therefore
# a no-op for it unless called with --greedy.
tap "stablyai/orca"
# Fully qualified on purpose. A bare `cask "orca"` resolves to homebrew-cask's
# core orca -- Plotly's chart exporter, which is Intel-only, unsigned, and
# deprecated for failing Gatekeeper. Different app entirely, and the source of
# the "Apple could not verify orca" alert: that build is unsigned, so no
# no_quarantine flag would have helped. The real Orca is properly signed.
cask "stablyai/orca/orca"


# ---------------------------------------------------------------------------
# Desktop / menu bar
#
# SketchyBar: the macOS analogue of Rhodium's Waybar. A fully scriptable status
# bar replacement -- centered clock, custom font, and shell-driven modules
# (CPU, memory, network, thermals, battery, layout). This is the base for a
# gradual port of the Rhodium bar; no config ships yet.
#
# Tap review: FelixKratz/homebrew-formulae ships sketchybar.rb, which builds
# from the pinned v2.24.0 source tag on github.com/FelixKratz/SketchyBar with a
# matching url, GPL-3.0-only. No prebuilt binary is pulled -- Homebrew compiles
# it and fetches only the documentation tarball from felixkratz.github.io. The
# formula declares a `service` block, so the bar runs via
# `brew services start sketchybar` once a config exists.
#
# Actively maintained: v2.24.0 released 2026-06-04, commits through June 2026.
# Runs on macOS 26 Tahoe. The one Tahoe regression (mirroring native menu-bar
# icons) was fixed in v2.24.0 and does not affect self-scripted modules.
#
# Homebrew 6 refuses to load a formula from an untrusted tap, so
# run_onchange_after_10-homebrew-bundle trusts this one formula (not the whole
# tap) before `brew bundle` runs. The trust lives in trust.json.
tap "FelixKratz/formulae"
brew "sketchybar"


