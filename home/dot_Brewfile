# Configuration management
brew "chezmoi"
brew "just"

# Shells
brew "fish"
brew "nushell"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Prompt and terminal sessions
brew "starship"
brew "zellij"

# Git
brew "git"
brew "gh"
brew "git-delta"
brew "gitui"
brew "lazygit"
brew "commitizen"
# Syntax-aware diffs. Understands structure rather than lines, which makes
# reviewing generated or refactored code far less noisy than a textual diff.
brew "difftastic"
# Jujutsu: Git-compatible VCS with first-class stacked changes, and the VCS
# GitHub's stacked-PR preview explicitly supports. Colocates with an existing
# Git repo, so adopting it is reversible.
brew "jj"

# Code quality gates. Hooks guard the front door, CI watches the perimeter --
# with agents writing at speed, the front door is what catches things early.
brew "lefthook"   # one binary, one config, every git hook
brew "gitleaks"   # secret scanning; replaces the hand-rolled rg check in justfile
brew "semgrep"    # semantic static analysis
brew "act"        # run GitHub Actions locally instead of push-wait-fail

# Shell history and navigation
brew "atuin"
brew "direnv"
brew "zoxide"
brew "fzf"

# Files and viewing
brew "bat"
brew "eza"
brew "fd"
brew "yazi"
brew "glow"

# Yazi previewers and plugin dependencies. Yazi degrades quietly when these are
# absent: the preview pane simply falls back to plain file(1) output.
brew "ffmpeg"      # video thumbnails
brew "sevenzip"    # archive listing
brew "poppler"     # PDF previews
brew "imagemagick" # SVG, HEIC, AVIF, JXL previews
brew "resvg"       # faster SVG rendering
brew "duckdb"      # CSV, TSV, Parquet and database previews
brew "mediainfo"   # media metadata
brew "ouch"        # archive preview and extraction

# Search and text processing
brew "ripgrep"
brew "ripgrep-all"
brew "sd"
brew "jq"
brew "yq"
brew "miller"

# Monitoring and storage
brew "btop"
brew "bottom"
brew "duf"
brew "dust"

# Network utilities
brew "wget"
brew "xh"

# General utilities
brew "tree"

# Editors
brew "neovim"
brew "helix"
# tree-sitter CLI lets nvim-treesitter build grammars that ship as grammar.js
# rather than checked-in C (latex is one). This is tree-sitter-cli, not
# tree-sitter: the latter is the library and ships no binary. node is needed
# only for that generation step, never at runtime.
brew "tree-sitter-cli"
brew "node"

# Python. The 2026 toolchain converged on uv + Ruff + a Rust type checker.
brew "uv"
brew "ruff"
# Pyrefly reached stable 1.0 in May 2026 and is dramatically faster than mypy
# (seconds rather than minutes on large trees) at a fraction of the memory.
# Astral's `ty` is the likely long-term successor but is still alpha, so it is
# deliberately not pinned here yet.
brew "pyrefly"

# Qalculate!: scientific calculator with a symbolic solver, unit and currency
# conversion, and plotting. A formula rather than a cask because upstream ships
# no macOS binary, so Homebrew compiles the Qt front end itself and leaves
# `qalculate-qt.app` inside the Cellar. `run_after_40-qalculate-app.sh.tmpl`
# copies that bundle into /Applications, which is what makes it reachable from
# Raycast. The formula also pulls in libqalculate, whose `qalc` command is the
# same engine on the terminal.
brew "qalculate-qt"

# Existing Homebrew-managed applications
cask "codex"
cask "claude-code"
cask "font-jetbrains-mono-nerd-font"
# Conductor: runs Claude Code sessions in parallel, each in its own git
# worktree, with a diff-first review UI. Works alongside VS Code rather than
# replacing it.
cask "conductor"
# Fantastical: each Google account is added inside the app and authenticated
# against the Google Calendar API directly, so it never routes through macOS
# Internet Accounts. That is the point -- Calendar.app reaches Google over
# CalDAV, which drops whenever the OAuth refresh token expires. Calendar Sets
# group the AtmosphericAI and personal accounts the way the Firefox profiles do.
cask "fantastical"
# Amie: also native, keyboard-driven throughout. Installed alongside Fantastical
# to trial both; drop the loser. Note Amie syncs through its own backend rather
# than authenticating locally, which is worth checking before a work Workspace
# account goes in it.
cask "amie"
# PDF Expert: full PDF reader and editor. Handles large and complex files that
# Preview struggles with, plus text editing, form filling and annotation.
cask "pdf-expert"

# Third-party tap, reviewed per the policy in README.md. Orca is an Agent
# Development Environment: it runs Claude Code, Codex and 30+ other CLI agents
# side by side, each in its own git worktree, and drives them with your existing
# subscriptions rather than proxying through a vendor. MIT licensed.
#
# Tap review: Casks/orca.rb in stablyai/homebrew-orca downloads the .dmg from
# github.com/stablyai/orca/releases with a matching `verified:` owner, pins a
# per-architecture sha256, declares no install scripts, and sets auto_updates
# because the app self-updates via electron-updater. `brew upgrade` is therefore
# a no-op for it unless called with --greedy.
tap "stablyai/orca"
# Fully qualified on purpose. A bare `cask "orca"` resolves to homebrew-cask's
# core orca -- Plotly's chart exporter, which is Intel-only, unsigned, and
# deprecated for failing Gatekeeper. Different app entirely, and the source of
# the "Apple could not verify orca" alert: that build is unsigned, so no
# no_quarantine flag would have helped. The real Orca is properly signed.
cask "stablyai/orca/orca"

