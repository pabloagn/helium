#!/bin/bash

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Calendar | AtmosphericAI
# @raycast.mode silent

# Optional parameters:
# @raycast.icon 📅
# @raycast.packageName Firefox Profiles
# @raycast.description Open Google Calendar in the AtmosphericAI Firefox profile
{{- if .firefoxAtmosphericProfile }}

exec "$HOME/.local/bin/helium-firefox" {{ .firefoxAtmosphericProfile | quote }} "https://calendar.google.com/"
{{- else }}

echo "Firefox AtmosphericAI profile is not configured in Chezmoi." >&2
exit 1
{{- end }}
