#!/bin/bash

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title GitHub Data | AtmosphericAI
# @raycast.mode silent

# Optional parameters:
# @raycast.icon icons/helium.png
# @raycast.iconDark icons/helium-dark.png
# @raycast.packageName Firefox Profiles
# @raycast.description Open the atmospheric_platform_data repo in the AtmosphericAI Firefox profile
{{- if .firefoxAtmosphericProfile }}

exec "$HOME/.local/bin/helium-firefox" {{ .firefoxAtmosphericProfile | quote }} "https://github.com/Atmosphericai/atmospheric_platform_data"
{{- else }}

echo "Firefox AtmosphericAI profile is not configured in Chezmoi." >&2
exit 1
{{- end }}
