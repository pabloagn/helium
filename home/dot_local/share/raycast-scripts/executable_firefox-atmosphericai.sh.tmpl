#!/bin/bash

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Firefox | AtmosphericAI
# @raycast.mode silent

# Optional parameters:
# @raycast.icon icons/helium.png
# @raycast.iconDark icons/helium-dark.png
# @raycast.packageName Firefox Profiles
# @raycast.description Open the AtmosphericAI Firefox profile in a new window
{{- if .firefoxAtmosphericProfile }}

exec "$HOME/.local/bin/helium-firefox" {{ .firefoxAtmosphericProfile | quote }}
{{- else }}

echo "Firefox AtmosphericAI profile is not configured in Chezmoi." >&2
exit 1
{{- end }}
