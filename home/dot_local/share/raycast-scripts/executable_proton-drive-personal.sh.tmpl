#!/bin/bash

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Proton Drive | Personal
# @raycast.mode silent

# Optional parameters:
# @raycast.icon icons/helium.png
# @raycast.iconDark icons/helium-dark.png
# @raycast.packageName Firefox Profiles
# @raycast.description Open Proton Drive in the Personal Firefox profile
{{- $personal := dig "firefoxPersonalProfile" "" . }}
{{- if $personal }}

exec "$HOME/.local/bin/helium-firefox" {{ $personal | quote }} "https://drive.proton.me/"
{{- else }}

echo "Firefox personal profile is not configured in Chezmoi. Run: chezmoi init" >&2
exit 1
{{- end }}
