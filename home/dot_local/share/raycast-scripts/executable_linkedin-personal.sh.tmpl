#!/bin/bash

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title LinkedIn | Personal
# @raycast.mode silent

# Optional parameters:
# @raycast.icon 💼
# @raycast.packageName Firefox Profiles
# @raycast.description Open LinkedIn in the Personal Firefox profile
{{- $personal := dig "firefoxPersonalProfile" "" . }}
{{- if $personal }}

exec "$HOME/.local/bin/helium-firefox" {{ $personal | quote }} "https://www.linkedin.com/"
{{- else }}

echo "Firefox personal profile is not configured in Chezmoi. Run: chezmoi init" >&2
exit 1
{{- end }}
