<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>com.helium.omniwm-display-layout</string>
    <key>ProgramArguments</key><array>
        <string>{{ .chezmoi.homeDir }}/.local/state/helium/bin/omniwm-display-layout</string>
        <string>--watch</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/.local/state/helium/omniwm-display-layout.log</string>
    <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/.local/state/helium/omniwm-display-layout.log</string>
</dict></plist>
