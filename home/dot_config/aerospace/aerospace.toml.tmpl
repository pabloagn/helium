# AeroSpace is the macOS counterpart to the Niri workflow in Rhodium.
# Right Command and Caps Lock are mapped to Hyper by Karabiner.
#
# Hyper is Control+Option+Shift+Command. Because Hyper already contains Shift,
# `Hyper+Shift` cannot be a distinct chord, so Niri's Mod / Mod+Shift split maps
# onto Hyper / Option+Shift here: Hyper acts on the focus, Option+Shift moves it
# or reaches the alternate of the same idea.
#
# Hyper must keep all four modifiers. Raycast and other applications register
# their own global hotkeys against this exact combination, and narrowing it
# silently breaks every one of them.

config-version = 2
start-at-login = true
auto-reload-config = true

# Keep the tree predictable. Nested containers remain available through service mode.
enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true
accordion-padding = 32
default-root-container-layout = 'tiles'
default-root-container-orientation = 'auto'

# Keyboard focus may cross displays without leaving the pointer behind.
on-focused-monitor-changed = ['move-mouse monitor-lazy-center']
on-mode-changed = ['exec-and-forget {{ .chezmoi.homeDir }}/.local/bin/aerospace-mode-notify']
automatically-unhide-macos-hidden-apps = true
# Focus must never follow the mouse. A fullscreen window still sits on top of
# the tiled layout underneath it, so any pointer movement would otherwise hand
# focus to whichever window happens to be beneath the cursor.
focus-follows-mouse.enabled = false

# Every workspace starts from the same neutral shape. Workspaces are not
# specialised, so nothing is preconfigured per number; change any container
# interactively with Option+Shift+Z or service mode.
#
# Only the nine numbers are persistent. Named workspaces (workspace mode,
# Hyper+U) are created on demand and die when their last window closes, so
# the pickers never fill with ghosts.
persistent-workspaces = ['1', '2', '3', '4', '5', '6', '7', '8', '9']

[exec]
inherit-env-vars = true

[exec.env-vars]
PATH = '/opt/homebrew/bin:/opt/homebrew/sbin:${PATH}'

[key-mapping]
preset = 'qwerty'

[gaps]
inner.horizontal = 12
inner.vertical = 12
outer.left = 12
outer.bottom = 12
outer.top = 12
outer.right = 12

# Workspace numbers, not applications, are tied to displays. This keeps
# Hyper+<number> spatially predictable when docked: 1 on the built-in laptop
# display (left), 2-8 on the MAG ultrawide (center), 9 on the Dell portrait
# (right).
#
# Patterns are case-insensitive regex substrings, matched left to right; the
# first pattern that names a connected display wins. Position numbers are
# avoided on purpose because they renumber themselves whenever a display
# disappears. `main` (the display holding the menu bar) is only the final
# catch-all, and `secondary` is meaningless with three displays, so neither
# leads any list.
#
# Fallbacks: 9 falls to the ultrawide when the Dell is unplugged, 2-8 fall
# to the laptop when the ultrawide is gone, and everything collapses onto
# whatever remains when undocked.
#
# An assigned workspace cannot be moved elsewhere: AeroSpace rejects both
# summon-workspace and move-workspace-to-monitor for it (verified live).
# The numbers are therefore fixed places; the portable, summonable
# workspaces are the named ones in workspace mode.
[workspace-to-monitor-force-assignment]
'1' = ['built-in', 'MAG', 'main']
'2' = ['MAG', 'built-in', 'main']
'3' = ['MAG', 'built-in', 'main']
'4' = ['MAG', 'built-in', 'main']
'5' = ['MAG', 'built-in', 'main']
'6' = ['MAG', 'built-in', 'main']
'7' = ['MAG', 'built-in', 'main']
'8' = ['MAG', 'built-in', 'main']
'9' = ['DELL', 'MAG', 'built-in', 'main']

[mode.main.binding]

# ---------------------------------------------------------------------------
# Focus (Niri: Mod+arrows, Mod+HJKL)
# ---------------------------------------------------------------------------
ctrl-alt-shift-cmd-left = 'focus --boundaries all-monitors-outer-frame --boundaries-action wrap-around-all-monitors left'
ctrl-alt-shift-cmd-down = 'focus --boundaries all-monitors-outer-frame --boundaries-action wrap-around-all-monitors down'
ctrl-alt-shift-cmd-up = 'focus --boundaries all-monitors-outer-frame --boundaries-action wrap-around-all-monitors up'
ctrl-alt-shift-cmd-right = 'focus --boundaries all-monitors-outer-frame --boundaries-action wrap-around-all-monitors right'
ctrl-alt-shift-cmd-h = 'focus --boundaries all-monitors-outer-frame --boundaries-action wrap-around-all-monitors left'
ctrl-alt-shift-cmd-j = 'focus --boundaries all-monitors-outer-frame --boundaries-action wrap-around-all-monitors down'
ctrl-alt-shift-cmd-k = 'focus --boundaries all-monitors-outer-frame --boundaries-action wrap-around-all-monitors up'
ctrl-alt-shift-cmd-l = 'focus --boundaries all-monitors-outer-frame --boundaries-action wrap-around-all-monitors right'

# ---------------------------------------------------------------------------
# Move the focused window (Niri: Mod+Ctrl+arrows, Mod+Ctrl+HJKL)
# Option+Shift is the single, consistent "take the window with me" layer.
# ---------------------------------------------------------------------------
alt-shift-left = 'move --boundaries all-monitors-outer-frame left'
alt-shift-down = 'move --boundaries all-monitors-outer-frame down'
alt-shift-up = 'move --boundaries all-monitors-outer-frame up'
alt-shift-right = 'move --boundaries all-monitors-outer-frame right'
alt-shift-h = 'move --boundaries all-monitors-outer-frame left'
alt-shift-j = 'move --boundaries all-monitors-outer-frame down'
alt-shift-k = 'move --boundaries all-monitors-outer-frame up'
alt-shift-l = 'move --boundaries all-monitors-outer-frame right'

# ---------------------------------------------------------------------------
# Workspaces (Niri: Mod+N focuses, Mod+Shift+N sends the window)
# Sending a window deliberately does not follow it, so a burst of sends from
# one workspace stays on that workspace.
# ---------------------------------------------------------------------------
ctrl-alt-shift-cmd-1 = 'workspace --auto-back-and-forth 1'
ctrl-alt-shift-cmd-2 = 'workspace --auto-back-and-forth 2'
ctrl-alt-shift-cmd-3 = 'workspace --auto-back-and-forth 3'
ctrl-alt-shift-cmd-4 = 'workspace --auto-back-and-forth 4'
ctrl-alt-shift-cmd-5 = 'workspace --auto-back-and-forth 5'
ctrl-alt-shift-cmd-6 = 'workspace --auto-back-and-forth 6'
ctrl-alt-shift-cmd-7 = 'workspace --auto-back-and-forth 7'
ctrl-alt-shift-cmd-8 = 'workspace --auto-back-and-forth 8'
ctrl-alt-shift-cmd-9 = 'workspace --auto-back-and-forth 9'

alt-shift-1 = 'move-node-to-workspace 1'
alt-shift-2 = 'move-node-to-workspace 2'
alt-shift-3 = 'move-node-to-workspace 3'
alt-shift-4 = 'move-node-to-workspace 4'
alt-shift-5 = 'move-node-to-workspace 5'
alt-shift-6 = 'move-node-to-workspace 6'
alt-shift-7 = 'move-node-to-workspace 7'
alt-shift-8 = 'move-node-to-workspace 8'
alt-shift-9 = 'move-node-to-workspace 9'

# Cycle only through workspaces that hold windows on the focused display.
# With unlimited named workspaces a blind next/prev walk stops scaling, so
# the occupied list is piped back in through --stdin, the pattern the
# AeroSpace docs recommend. The move-layer brackets below still walk every
# workspace, so an empty one stays reachable as a send target.
ctrl-alt-shift-cmd-leftSquareBracket = 'exec-and-forget aerospace list-workspaces --monitor focused --empty no | aerospace workspace --wrap-around --stdin prev'
ctrl-alt-shift-cmd-rightSquareBracket = 'exec-and-forget aerospace list-workspaces --monitor focused --empty no | aerospace workspace --wrap-around --stdin next'
alt-shift-leftSquareBracket = 'move-node-to-workspace --wrap-around prev'
alt-shift-rightSquareBracket = 'move-node-to-workspace --wrap-around next'

# Niri's Mod+Tab returns to the previous workspace; the move-layer variant
# returns to the previously focused window instead.
ctrl-alt-shift-cmd-tab = 'workspace-back-and-forth'
alt-shift-tab = 'focus-back-and-forth'

# ---------------------------------------------------------------------------
# Displays. Niri uses Mod+,/. for consume-or-expel; AeroSpace has no columns,
# so the same keys address the far more useful three-display setup, and
# join-with lives in service mode instead.
# ---------------------------------------------------------------------------
ctrl-alt-shift-cmd-comma = 'focus-monitor --wrap-around prev'
ctrl-alt-shift-cmd-period = 'focus-monitor --wrap-around next'
alt-shift-comma = 'move-node-to-monitor --focus-follows-window --wrap-around prev'
alt-shift-period = 'move-node-to-monitor --focus-follows-window --wrap-around next'

# ---------------------------------------------------------------------------
# Window and layout (Niri: Mod+C close, Mod+V float, Mod+F maximize,
# Mod+Shift+F fullscreen, Mod+Z tabbed, Mod+R preset widths)
# ---------------------------------------------------------------------------
ctrl-alt-shift-cmd-c = 'close'
alt-shift-c = 'close-all-windows-but-current'
ctrl-alt-shift-cmd-v = 'layout floating tiling'
ctrl-alt-shift-cmd-f = 'fullscreen'
alt-shift-f = 'macos-native-fullscreen'
ctrl-alt-shift-cmd-slash = 'layout horizontal vertical'

# O for orientation: flip the whole workspace between side-by-side and
# stacked in one press (--root acts on the workspace root). The nearest
# Niri stacking habit -- Mod+Ctrl+A/S moving a window into the column below
# or above -- is already Option+Shift+J/K here, which builds the vertical
# container implicitly.
alt-shift-o = 'layout --root horizontal vertical'

# Niri puts its tabbed-display toggle on Mod+Z. Hyper+Z is the AtmosphericAI
# browser here, so the accordion toggle keeps the key on the move layer.
alt-shift-z = 'layout tiles accordion'

# Group the focused window with the window below it under one vertical
# parent. join-with is the docs' replacement for i3's split; the plain
# `split` command is dead while flatten-containers normalization is on.
# The other three directions stay in service mode.
alt-shift-v = 'join-with down'

# Niri: Mod+-/= sizes the column, Option+Shift+-/= sizes the window in it.
ctrl-alt-shift-cmd-minus = 'resize width -80'
ctrl-alt-shift-cmd-equal = 'resize width +80'
alt-shift-minus = 'resize height -80'
alt-shift-equal = 'resize height +80'

# Niri's Mod+R cycles preset widths; resize mode is the interactive equivalent.
# Mod+Ctrl+R resets the height there, which is balance-sizes here.
ctrl-alt-shift-cmd-r = 'mode resize'
alt-shift-r = 'balance-sizes'
ctrl-alt-shift-cmd-semicolon = 'mode service'
# Workspace mode: unlimited named workspaces on bare letters. See the
# [mode.workspace.binding] block.
ctrl-alt-shift-cmd-u = 'mode workspace'

# Karabiner owns the physical Hyper+R and Hyper+; chords and invokes the mode
# command through the CLI. Native bindings remain as a fallback if Karabiner is
# temporarily unavailable or its layer action does not consume the event.
f18 = 'mode resize'
f19 = 'mode service'

# ---------------------------------------------------------------------------
# Launchers. The primary key matches Niri; Option+Shift reaches the alternate
# tool for the same job.
#
# These use `open -na`, not `open -a`: -a merely focuses an already-running
# instance, while -n always spawns a new window. The apps still on plain -a
# below are single-instance by design and refuse a second copy.
# ---------------------------------------------------------------------------
ctrl-alt-shift-cmd-enter = 'exec-and-forget open -na Ghostty.app'
ctrl-alt-shift-cmd-w = 'exec-and-forget {{ .chezmoi.homeDir }}/.local/bin/aerospace-open-here h com.mitchellh.ghostty open -na Ghostty.app'
alt-shift-w = 'exec-and-forget {{ .chezmoi.homeDir }}/.local/bin/aerospace-open-here v com.mitchellh.ghostty open -na Ghostty.app'

ctrl-alt-shift-cmd-b = 'exec-and-forget {{ .chezmoi.homeDir }}/.local/bin/ff-personal'
ctrl-alt-shift-cmd-z = 'exec-and-forget {{ .chezmoi.homeDir }}/.local/bin/ff-atmospheric'
alt-shift-b = 'exec-and-forget open -na Safari'

ctrl-alt-shift-cmd-d = 'exec-and-forget open -na Ghostty.app --args -e yazi'
ctrl-alt-shift-cmd-e = 'exec-and-forget open -na Ghostty.app --args -e nvim'
alt-shift-e = 'exec-and-forget open -na Zed'
ctrl-alt-shift-cmd-i = 'exec-and-forget open -na "Visual Studio Code"'
alt-shift-i = 'exec-and-forget open -na Cursor'

# Hyper+A is deliberately left free: Raycast registers it as its own global
# hotkey, and an AeroSpace binding on the same chord would shadow it.
alt-shift-a = 'exec-and-forget open -a ChatGPT'
ctrl-alt-shift-cmd-n = 'exec-and-forget open -a Notion'
alt-shift-n = 'exec-and-forget open -a Linear'
ctrl-alt-shift-cmd-m = 'exec-and-forget open -a Slack'
alt-shift-m = 'exec-and-forget open -a WhatsApp'
ctrl-alt-shift-cmd-t = 'exec-and-forget open -a "Microsoft Teams"'
alt-shift-t = 'exec-and-forget open -a zoom.us'
ctrl-alt-shift-cmd-g = 'exec-and-forget open -a Spotify'
ctrl-alt-shift-cmd-p = 'exec-and-forget open -a 1Password'
ctrl-alt-shift-cmd-o = 'exec-and-forget open {{ .chezmoi.homeDir }}/Downloads'

# Niri: Mod+Q calculator, Mod+X overview, Mod+Escape lock.
ctrl-alt-shift-cmd-q = 'exec-and-forget open -na Calculator'
ctrl-alt-shift-cmd-x = 'exec-and-forget open -a "Mission Control"'
ctrl-alt-shift-cmd-esc = 'exec-and-forget pmset displaysleepnow'

# Niri: Mod+S captures the screen, Mod+Shift+S captures a selection,
# Mod+Alt+S captures a window. The selection capture goes to the clipboard,
# which is what it is actually used for; the other two write files.
ctrl-alt-shift-cmd-s = 'exec-and-forget {{ .chezmoi.homeDir }}/.local/bin/helium-screenshot screen'
alt-shift-s = 'exec-and-forget {{ .chezmoi.homeDir }}/.local/bin/helium-screenshot region-clip'
ctrl-alt-shift-cmd-y = 'exec-and-forget {{ .chezmoi.homeDir }}/.local/bin/helium-screenshot window'

# ---------------------------------------------------------------------------
# Finding things. Raycast owns its own launcher hotkeys (Hyper+A, Hyper+0),
# so Space is free for search: Hyper focuses a window, the move layer
# reaches the workspace alternate, matching the layer split everywhere
# else. Option+Shift+Enter jumps to an empty workspace on the focused
# display first, so a clean full-width slate is always one chord away. The
# workspace picker also lives on Space inside workspace mode.
# ---------------------------------------------------------------------------
ctrl-alt-shift-cmd-space = 'exec-and-forget {{ .chezmoi.homeDir }}/.local/bin/aerospace-window-picker'
alt-shift-space = 'exec-and-forget {{ .chezmoi.homeDir }}/.local/bin/aerospace-workspace-picker'
alt-shift-enter = 'exec-and-forget {{ .chezmoi.homeDir }}/.local/bin/aerospace-empty-workspace'

# Both bare and Hyper-modified keys work. You can release Hyper after entering
# the mode or keep holding it; Escape, Enter, or the entry chord exits.
[mode.resize.binding]
esc = 'mode main'
enter = 'mode main'
left = 'resize width -80'
down = 'resize height +80'
up = 'resize height -80'
right = 'resize width +80'
h = 'resize width -80'
j = 'resize height +80'
k = 'resize height -80'
l = 'resize width +80'
minus = 'resize smart -80'
equal = 'resize smart +80'
ctrl-alt-shift-cmd-left = 'resize width -80'
ctrl-alt-shift-cmd-down = 'resize height +80'
ctrl-alt-shift-cmd-up = 'resize height -80'
ctrl-alt-shift-cmd-right = 'resize width +80'
ctrl-alt-shift-cmd-h = 'resize width -80'
ctrl-alt-shift-cmd-j = 'resize height +80'
ctrl-alt-shift-cmd-k = 'resize height -80'
ctrl-alt-shift-cmd-l = 'resize width +80'
ctrl-alt-shift-cmd-minus = 'resize smart -80'
ctrl-alt-shift-cmd-equal = 'resize smart +80'
ctrl-alt-shift-cmd-r = 'mode main'
b = ['balance-sizes', 'mode main']

[mode.service.binding]
esc = 'mode main'
enter = 'mode main'
r = ['flatten-workspace-tree', 'balance-sizes', 'mode main']
b = ['balance-sizes', 'mode main']
f = ['layout floating tiling', 'mode main']
t = ['layout tiles', 'mode main']
a = ['layout accordion', 'mode main']
slash = ['layout horizontal vertical', 'mode main']
left = ['join-with left', 'mode main']
down = ['join-with down', 'mode main']
up = ['join-with up', 'mode main']
right = ['join-with right', 'mode main']
h = ['join-with left', 'mode main']
j = ['join-with down', 'mode main']
k = ['join-with up', 'mode main']
l = ['join-with right', 'mode main']
ctrl-alt-shift-cmd-left = ['join-with left', 'mode main']
ctrl-alt-shift-cmd-down = ['join-with down', 'mode main']
ctrl-alt-shift-cmd-up = ['join-with up', 'mode main']
ctrl-alt-shift-cmd-right = ['join-with right', 'mode main']
ctrl-alt-shift-cmd-semicolon = 'mode main'
m = ['move-node-to-monitor --focus-follows-window --wrap-around next', 'mode main']
n = ['macos-native-fullscreen', 'mode main']
backspace = ['close-all-windows-but-current', 'mode main']

# Workspace mode (Hyper+U). Bare numbers focus the nine pinned workspaces,
# exactly like Hyper+<number>, so the hand can leave Hyper once the mode is
# open. Bare letters summon named workspaces: created on demand, pulled to
# the focused display, gone when their last window closes -- Niri's model.
# Option+Shift+<key> sends the focused window there without following it,
# mirroring the main layer. Space opens the workspace picker. Escape,
# Enter, or Hyper+U exits.
[mode.workspace.binding]
esc = 'mode main'
enter = 'mode main'
ctrl-alt-shift-cmd-u = 'mode main'
space = ['exec-and-forget {{ .chezmoi.homeDir }}/.local/bin/aerospace-workspace-picker', 'mode main']

1 = ['workspace 1', 'mode main']
2 = ['workspace 2', 'mode main']
3 = ['workspace 3', 'mode main']
4 = ['workspace 4', 'mode main']
5 = ['workspace 5', 'mode main']
6 = ['workspace 6', 'mode main']
7 = ['workspace 7', 'mode main']
8 = ['workspace 8', 'mode main']
9 = ['workspace 9', 'mode main']

a = ['summon-workspace a', 'mode main']
b = ['summon-workspace b', 'mode main']
c = ['summon-workspace c', 'mode main']
d = ['summon-workspace d', 'mode main']
e = ['summon-workspace e', 'mode main']
f = ['summon-workspace f', 'mode main']
g = ['summon-workspace g', 'mode main']
h = ['summon-workspace h', 'mode main']
i = ['summon-workspace i', 'mode main']
j = ['summon-workspace j', 'mode main']
k = ['summon-workspace k', 'mode main']
l = ['summon-workspace l', 'mode main']
m = ['summon-workspace m', 'mode main']
n = ['summon-workspace n', 'mode main']
o = ['summon-workspace o', 'mode main']
p = ['summon-workspace p', 'mode main']
q = ['summon-workspace q', 'mode main']
r = ['summon-workspace r', 'mode main']
s = ['summon-workspace s', 'mode main']
t = ['summon-workspace t', 'mode main']
u = ['summon-workspace u', 'mode main']
v = ['summon-workspace v', 'mode main']
w = ['summon-workspace w', 'mode main']
x = ['summon-workspace x', 'mode main']
y = ['summon-workspace y', 'mode main']
z = ['summon-workspace z', 'mode main']

alt-shift-1 = ['move-node-to-workspace 1', 'mode main']
alt-shift-2 = ['move-node-to-workspace 2', 'mode main']
alt-shift-3 = ['move-node-to-workspace 3', 'mode main']
alt-shift-4 = ['move-node-to-workspace 4', 'mode main']
alt-shift-5 = ['move-node-to-workspace 5', 'mode main']
alt-shift-6 = ['move-node-to-workspace 6', 'mode main']
alt-shift-7 = ['move-node-to-workspace 7', 'mode main']
alt-shift-8 = ['move-node-to-workspace 8', 'mode main']
alt-shift-9 = ['move-node-to-workspace 9', 'mode main']

alt-shift-a = ['move-node-to-workspace a', 'mode main']
alt-shift-b = ['move-node-to-workspace b', 'mode main']
alt-shift-c = ['move-node-to-workspace c', 'mode main']
alt-shift-d = ['move-node-to-workspace d', 'mode main']
alt-shift-e = ['move-node-to-workspace e', 'mode main']
alt-shift-f = ['move-node-to-workspace f', 'mode main']
alt-shift-g = ['move-node-to-workspace g', 'mode main']
alt-shift-h = ['move-node-to-workspace h', 'mode main']
alt-shift-i = ['move-node-to-workspace i', 'mode main']
alt-shift-j = ['move-node-to-workspace j', 'mode main']
alt-shift-k = ['move-node-to-workspace k', 'mode main']
alt-shift-l = ['move-node-to-workspace l', 'mode main']
alt-shift-m = ['move-node-to-workspace m', 'mode main']
alt-shift-n = ['move-node-to-workspace n', 'mode main']
alt-shift-o = ['move-node-to-workspace o', 'mode main']
alt-shift-p = ['move-node-to-workspace p', 'mode main']
alt-shift-q = ['move-node-to-workspace q', 'mode main']
alt-shift-r = ['move-node-to-workspace r', 'mode main']
alt-shift-s = ['move-node-to-workspace s', 'mode main']
alt-shift-t = ['move-node-to-workspace t', 'mode main']
alt-shift-u = ['move-node-to-workspace u', 'mode main']
alt-shift-v = ['move-node-to-workspace v', 'mode main']
alt-shift-w = ['move-node-to-workspace w', 'mode main']
alt-shift-x = ['move-node-to-workspace x', 'mode main']
alt-shift-y = ['move-node-to-workspace y', 'mode main']
alt-shift-z = ['move-node-to-workspace z', 'mode main']

# No application is pinned to a workspace. Every window opens on whatever
# workspace is focused when it appears, and stays there until it is moved
# deliberately with Option+Shift+<number>.
#
# The only callbacks that remain float windows that are never worth tiling.
# Callback evaluation stops after the first match.
[[on-window-detected]]
if = 'test %{window-title} = "Picture-in-Picture"'
run = 'layout floating'

[[on-window-detected]]
if = 'test %{app-bundle-id} = com.raycast.macos || test %{app-bundle-id} = com.1password.1password || test %{app-bundle-id} = com.apple.systempreferences || test %{app-bundle-id} = com.apple.calculator || test %{app-bundle-id} = com.apple.quicklook.QuickLookUIService'
run = 'layout floating'
