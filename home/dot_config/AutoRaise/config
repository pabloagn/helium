#AutoRaise config file
#
# Focus follows the mouse, replacing AeroSpace's focus-follows-mouse switch
# (kept false in aerospace.toml). AeroSpace's switch follows its own window
# tree, so hovering a fullscreen or floating window focused the tiled window
# underneath it. AutoRaise reads the real topmost window under the cursor
# through the accessibility API, so alerts and dialogs keep focus.
#
# This is the standard raise mode: the hovered window is focused and raised.
# Tiles do not overlap, so raise changes nothing for them. AutoRaise's
# focus-without-raise mode is deliberately not used -- it needs the
# EXPERIMENTAL_FOCUS_FIRST compile flag, which relies on private API calls
# that can break on any macOS update.

# Poll every 20ms, the minimum AutoRaise allows. delay is in units of
# pollMillis, and any delay > 1 also demands a momentary mouse stop before the
# raise -- that stop is the real sweep filter, not the length of the delay.
# So the delay stays as short as it can be while still engaging the stop rule:
# 2 polls = 40ms. Larger values (a 200ms dwell was tried) just feel broken,
# because the clock only starts once the mouse has already stopped.
pollMillis=20
delay=2

# mouseDelta is the movement threshold for that stop detection. 0.0 demands a
# pixel-perfect standstill, which made the raise miss natural hand tremor;
# 0.1 is the value upstream's own sample config ships.
requireMouseStop=false
mouseDelta=0.1

# Never steal focus from the macOS credential dialog. It is a floating window
# by nature, and losing focus mid-password is the worst version of this bug.
stayFocusedBundleIds="com.apple.SecurityAgent"

# Do not raise anything right after a workspace switch. AeroSpace has just
# placed focus deliberately; the cursor position is stale at that moment.
ignoreSpaceChanged=true

# Hold Control to suspend AutoRaise temporarily. Hyper contains Control, so
# every Hyper chord also suspends it -- which is exactly right: keyboard
# focus commands must win while they are being issued.
disableKey="control"
