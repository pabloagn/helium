# Berkeley Mono Rh (TX-02) is the primary face. That build ships Powerline and
# box-drawing glyphs but NOT the Nerd Font icon ranges (seti, devicons, Font
# Awesome, Material), so JetBrains Mono Nerd Font is listed second purely as an
# icon fallback -- without it, Yazi/eza/starship icons render as tofu.
# Ghostty falls back in declaration order.
font-family = "Berkeley Mono Rh"
font-family = "JetBrainsMono Nerd Font Mono"

# Berkeley Mono names its slanted faces "Oblique", not "Italic".
font-style-italic = "Oblique"
font-style-bold-italic = "Bold Oblique"
font-size = 14
font-thicken = true

theme = Kanso Zen

window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-inherit-working-directory = true
window-inherit-font-size = true
window-save-state = always
window-colorspace = display-p3
background-opacity = 0.97
background-blur-radius = 20
unfocused-split-opacity = 0.9

macos-titlebar-style = tabs
macos-option-as-alt = true

cursor-style = block
cursor-style-blink = false

shell-integration = detect
shell-integration-features = no-cursor,sudo,title

scrollback-limit = 100000
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

quick-terminal-position = top
quick-terminal-size = 40%
quick-terminal-autohide = true
keybind = global:ctrl+alt+shift+super+grave_accent=toggle_quick_terminal

keybind = super+shift+enter=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+shift+w=close_surface
keybind = super+k=clear_screen

